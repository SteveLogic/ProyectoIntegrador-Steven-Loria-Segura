# Puerto de Render o de la máquina local. Render define PORT automáticamente.
PORT=3000
# Sustituir con cadena privada de MongoDB Atlas en variables de entorno del hosting.
MONGO_URI=mongodb://127.0.0.1:27017/Proyecto_Integrador
# Opcional si el frontend se aloja en un dominio DIFERENTE al backend:
# FRONTEND_ORIGINS=https://mi-web.netlify.app,https://mi-web.vercel.app

# Para recuperación segura por correo (Resend): configurar solo en .env/Render.
# Crear clave en https://resend.com y verificar dominio remitente.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESET_EMAIL_FROM=Citas Medicas <no-reply@tudominio.com>
# APP_PUBLIC_URL=https://sistema-citas-medicas-88xk.onrender.com
